{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/particle-ai/particle-1:free",
  "small_model": "openrouter/nvidia/nemotron-3.5-lightning:free",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "particle-ai/particle-1:free": {
          "name": "Particle-1 Free (Primary Coding)"
        },
        "recursive/flint-v1.0:free": {
          "name": "Recursive Flint v1.0 Free (Secondary Coding)"
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "NVIDIA Nemotron 3 Ultra Free (Reasoning & Review)"
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "NVIDIA Nemotron 3.5 Lightning Free (Fast Docs & Light Edits)"
        },
        "google/gemma-4-26b-a4b-it:free": {
          "name": "Google Gemma 4 26B A4B Free (Structured JSON & Bangla)"
        }
      }
    }
  }
}
