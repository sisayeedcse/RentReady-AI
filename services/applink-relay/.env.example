# Copy to .env for local dev (pnpm dev:relay) or on your DigitalOcean/Static-IPv4 VPS (NEVER commit .env)
PORT=8788
# Bind 0.0.0.0 inside Docker (and expose host port as -p 127.0.0.1:8788:8788 behind Caddy HTTPS);
# set RELAY_HOST=127.0.0.1 when running Node directly on the VPS host behind Caddy/Nginx.
RELAY_HOST=0.0.0.0
RELAY_SHARED_SECRET=replace-with-32-byte-random-hex
APPLINK_APPLICATION_ID=APP_000000
APPLINK_PASSWORD=replace-with-applink-api-password
